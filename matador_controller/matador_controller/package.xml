<?xml version="1.0"?>
<package format="3">
  <name>matador_controller</name>
  <version>0.0.1</version>
  <description>Simple ROS 2 Jazzy AprilTag follower for a TurtleBot3 Burger.</description>
  <maintainer email="student@example.com">Student</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>apriltag_msgs</exec_depend>
